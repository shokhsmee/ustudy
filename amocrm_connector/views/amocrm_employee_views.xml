<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_amocrm_employee_list" model="ir.ui.view">
        <field name="name">amocrm.employee.list</field>
        <field name="model">amocrm.employee</field>
        <field name="arch" type="xml">
            <!-- editable: the whole point is to map each amoCRM xodim to an
                 Odoo user inline. Records themselves come from sync only. -->
            <list string="amoCRM xodimlari" editable="bottom" create="0" delete="0"
                  decoration-muted="not is_active">
                <field name="amocrm_id" string="amoCRM ID" readonly="1"/>
                <field name="name" readonly="1"/>
                <field name="email" readonly="1"/>
                <field name="role_name" string="Rol" readonly="1" optional="show"/>
                <field name="group_name" string="Guruh" readonly="1" optional="hide"/>
                <field name="is_admin" readonly="1" optional="hide"/>
                <field name="is_active" readonly="1" optional="show"/>
                <field name="user_id" string="Odoo foydalanuvchisi"
                       options="{'no_create': True}"/>
                <field name="last_sync" readonly="1" optional="hide"/>
                <button name="action_open_kpi_dashboard" type="object"
                        icon="fa-line-chart" title="KPI Dashboard"/>
            </list>
        </field>
    </record>

    <record id="view_amocrm_employee_form" model="ir.ui.view">
        <field name="name">amocrm.employee.form</field>
        <field name="model">amocrm.employee</field>
        <field name="arch" type="xml">
            <form string="amoCRM xodimi">
                <header>
                    <button name="action_open_kpi_dashboard" type="object"
                            string="KPI Dashboard" class="btn-primary"
                            icon="fa-line-chart"/>
                </header>
                <sheet>
                    <group>
                        <group string="amoCRM">
                            <field name="amocrm_id" readonly="1"/>
                            <field name="name" readonly="1"/>
                            <field name="email" readonly="1"/>
                            <field name="role_name" readonly="1"/>
                            <field name="group_name" readonly="1"/>
                            <field name="is_admin" readonly="1"/>
                            <field name="is_active" readonly="1"/>
                            <field name="last_sync" readonly="1"/>
                        </group>
                        <group string="Odoo bog'lanish">
                            <field name="user_id" options="{'no_create': True}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Xom ma'lumot (JSON)">
                            <field name="raw_data" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_amocrm_employee_search" model="ir.ui.view">
        <field name="name">amocrm.employee.search</field>
        <field name="model">amocrm.employee</field>
        <field name="arch" type="xml">
            <search string="amoCRM xodimlari">
                <field name="name"/>
                <field name="email"/>
                <field name="user_id"/>
                <filter name="active" string="Faol" domain="[('is_active', '=', True)]"/>
                <filter name="unmapped" string="Bog'lanmagan"
                        domain="[('user_id', '=', False)]"/>
                <filter name="mapped" string="Bog'langan"
                        domain="[('user_id', '!=', False)]"/>
                <separator/>
                <filter name="group_role" string="Rol bo'yicha"
                        context="{'group_by': 'role_name'}"/>
            </search>
        </field>
    </record>

    <record id="action_amocrm_employees" model="ir.actions.act_window">
        <field name="name">amoCRM xodimlari</field>
        <field name="res_model">amocrm.employee</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_amocrm_employee_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Hozircha amoCRM xodimlari yo'q</p>
            <p>Sozlamalar &gt; amoCRM bo'limida "Xodimlarni sinxronlash" tugmasini bosing.</p>
        </field>
    </record>

</odoo>
