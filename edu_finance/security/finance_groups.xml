<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ============================================================
             GROUP: Finance Ledger Admin
             Members can override the soft-lock on validated (posted)
             account.move entries generated by the education finance engine.
             Normal users cannot delete these entries; ledger admins can.
        ============================================================ -->
        <record id="group_finance_ledger_admin" model="res.groups">
            <field name="name">Finance: Ledger Admin (Soft Lock Override)</field>
            <field name="category_id" ref="base.module_category_accounting_and_finance"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">
                Can delete validated (posted) education finance ledger entries.
                This is the override right for the soft-lock mechanism.
            </field>
        </record>

        <!-- System administrators automatically get ledger admin rights. -->
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('edu_finance.group_finance_ledger_admin'))]"/>
        </record>

        <!-- ============================================================
             GROUP: Refund Approver
             Members can approve refund requests (transition from
             'pending_approval' to 'approved'). Without this right, users
             can only submit and view refunds.
        ============================================================ -->
        <record id="group_refund_approver" model="res.groups">
            <field name="name">Finance: Refund Approver</field>
            <field name="category_id" ref="base.module_category_accounting_and_finance"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">
                Can approve or reject refund requests. Refund validation
                (posting the credit note) is a separate step available to
                any user who can approve.
            </field>
        </record>

        <!-- System administrators automatically get refund approver rights. -->
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('edu_finance.group_refund_approver'))]"/>
        </record>

    </data>
</odoo>
