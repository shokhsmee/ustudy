<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Finance Form View -->
    <record id="view_cc_finance_form" model="ir.ui.view">
        <field name="name">cc.finance.form</field>
        <field name="model">cc.finance</field>
        <field name="arch" type="xml">
            <form string="Finance Record">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" 
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Cancel" type="object" 
                            invisible="state != 'confirmed'"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" 
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="transaction_type" widget="radio" readonly="1"/>
                            <field name="payment_type_id"
                                   domain="[('direction', '=', 'kirim' if transaction_type == 'income' else 'chiqim')]"/>
                            <field name="payment_method_id"/>
                        </group>
                        <group>
                            <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="balance_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    
                    <group string="Related To" name="related_to_group">
                        <group>
                            <field name="partner_id" 
                                   string="Student/Contact"
                                   invisible="payment_type_id and payment_type_id.type_category in ['teacher', 'employee']"/>
                        </group>
                        <group>
                            <field name="employee_id"
                                   string="Teacher/Employee"
                                   invisible="payment_type_id and payment_type_id.type_category == 'student'"/>
                        </group>
                    </group>
                    
                    <!-- <group>
                        <field name="crm_request_id"/>
                    </group> -->
                    
                    <group>
                        <field name="description" placeholder="Add description here..."/>
                    </group>
                    
                    <notebook>
                        <page string="Notes">
                            <field name="notes" placeholder="Additional notes..."/>
                        </page>
                        <page string="Attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    
    <!-- Finance Tree View -->
    <record id="view_cc_finance_tree" model="ir.ui.view">
        <field name="name">cc.finance.list</field>
        <field name="model">cc.finance</field>
        <field name="arch" type="xml">
            <list string="Finance" js_class="finance_dashboard_list"
                decoration-success="transaction_type == 'income'"
                decoration-danger="transaction_type == 'expense'">
                <field name="date"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="employee_id"/>
                <field name="transaction_type"/>
                <field name="payment_type_id"/>
                <field name="payment_method_id"/>
                <field name="amount" sum="Total Amount" widget="monetary" optional="hide"/>
                <field name="balance_amount" sum="Total Balance" widget="monetary"/>
                <field name="company_id" optional="hide"/>
                <field name="state" widget="badge" 
                       decoration-success="state == 'confirmed'"
                       decoration-info="state == 'draft'"
                       decoration-danger="state == 'cancelled'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    
    <!-- Finance Search View -->
    <record id="view_cc_finance_search" model="ir.ui.view">
        <field name="name">cc.finance.search</field>
        <field name="model">cc.finance</field>
        <field name="arch" type="xml">
            <search string="Search Finance">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="employee_id"/>
                <field name="payment_type_id"/>
                <field name="payment_method_id"/>
                
                <filter string="Income" name="filter_income" domain="[('transaction_type', '=', 'income')]"/>
                <filter string="Expense" name="filter_expense" domain="[('transaction_type', '=', 'expense')]"/>
                
                <separator/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="filter_confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Cancelled" name="filter_cancelled" domain="[('state', '=', 'cancelled')]"/>
                
                <separator/>
                <filter string="Today" name="filter_today" domain="[('date', '=', context_today())]"/>
                <filter string="This Week" name="filter_this_week" domain="[('date', '&gt;=', (context_today() - relativedelta(weeks=1)))]"/>
                <filter string="This Month" name="filter_this_month" domain="[('date', '&gt;=', (context_today() - relativedelta(day=1)))]"/>
                <filter string="This Year" name="filter_this_year" domain="[('date', '&gt;=', (context_today() - relativedelta(month=1, day=1)))]"/>
                
                <!-- <group expand="0" string="Group By">
                    <filter string="Transaction Type" name="group_transaction_type" context="{'group_by': 'transaction_type'}"/>
                    <filter string="Payment Type" name="group_payment_type" context="{'group_by': 'payment_type_id'}"/>
                    <filter string="Payment Method" name="group_payment_method" context="{'group_by': 'payment_method_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'date'}"/>
                </group> -->
            </search>
        </field>
    </record>
    
    <!-- Finance Graph View -->
    <record id="view_cc_finance_graph" model="ir.ui.view">
        <field name="name">cc.finance.graph</field>
        <field name="model">cc.finance</field>
        <field name="arch" type="xml">
            <graph string="Finance Analytics" type="bar">
                
                <!-- Measures -->
                <field name="amount" type="measure"/>
                <field name="balance_amount" type="measure"/>

                <!-- Dimensions -->
                <field name="transaction_type"/>
                <field name="company_id"/>
                <field name="payment_type_id"/>
                <field name="payment_method_id"/>
            </graph>
        </field>
    </record>
    
    <!-- Finance Pivot View -->
    <record id="view_cc_finance_pivot" model="ir.ui.view">
        <field name="name">cc.finance.pivot</field>
        <field name="model">cc.finance</field>
        <field name="arch" type="xml">
            <pivot string="Finance Pivot">
                <!-- Measures -->
                <field name="amount" type="measure"/>
                <field name="balance_amount" type="measure"/>

                <!-- Rows/Columns -->
                <field name="date" type="row" interval="month"/>
                <field name="company_id" type="row"/>
                <field name="payment_type_id" type="col"/>
                <field name="transaction_type" type="col"/>
            </pivot>
        </field>
    </record>
    
    <!-- Finance Action (all records) -->
    <record id="action_cc_finance" model="ir.actions.act_window">
        <field name="name">Barcha to'lovlar</field>
        <field name="res_model">cc.finance</field>
        <field name="view_mode">list,form,graph,pivot</field>
        <field name="context">{'search_default_filter_this_month': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first finance record
            </p>
            <p>
                Track income and expenses for your education center.
            </p>
        </field>
    </record>

    <!-- Income only (Kirimlar) -->
    <record id="action_cc_finance_income" model="ir.actions.act_window">
        <field name="name">Kirimlar</field>
        <field name="res_model">cc.finance</field>
        <field name="view_mode">list,form,graph,pivot</field>
        <field name="domain">[('transaction_type', '=', 'income')]</field>
        <field name="context">{'default_transaction_type': 'income', 'search_default_filter_this_month': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Hozircha kirim yo'q</p>
            <p>Kelib tushgan to'lovlar (kirimlar) shu yerda ko'rinadi.</p>
        </field>
    </record>

    <!-- Expense only (Chiqimlar) -->
    <record id="action_cc_finance_expense" model="ir.actions.act_window">
        <field name="name">Chiqimlar</field>
        <field name="res_model">cc.finance</field>
        <field name="view_mode">list,form,graph,pivot</field>
        <field name="domain">[('transaction_type', '=', 'expense')]</field>
        <field name="context">{'default_transaction_type': 'expense', 'search_default_filter_this_month': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Hozircha chiqim yo'q</p>
            <p>Chiqimlar (xarajatlar) shu yerda ko'rinadi.</p>
        </field>
    </record>

</odoo>