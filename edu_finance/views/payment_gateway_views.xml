<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         PAYMENT GATEWAY: FORM VIEW
    ============================================================ -->
    <record id="view_payment_gateway_form" model="ir.ui.view">
        <field name="name">payment.gateway.form</field>
        <field name="model">payment.gateway</field>
        <field name="arch" type="xml">
            <form string="Payment Gateway">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_transactions"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-exchange">
                            <field name="transaction_count" widget="statinfo" string="Transactions"/>
                        </button>
                        <button name="action_test_connection"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-plug">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Test</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Payme Production"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Provider">
                            <field name="provider"/>
                            <field name="environment" widget="radio"/>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="sequence"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Credentials">
                            <field name="merchant_id" password="True"/>
                            <field name="api_key" password="True"/>
                            <field name="api_endpoint" placeholder="https://..."/>
                            <field name="webhook_secret" password="True"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Advanced" name="advanced">
                            <group>
                                <field name="extra_config"
                                       placeholder='{"timeout": 30, "retry": 3}'/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============================================================
         PAYMENT GATEWAY: LIST VIEW
    ============================================================ -->
    <record id="view_payment_gateway_list" model="ir.ui.view">
        <field name="name">payment.gateway.list</field>
        <field name="model">payment.gateway</field>
        <field name="arch" type="xml">
            <list string="Payment Gateways">
                <field name="sequence" widget="handle"/>
                <field name="name" decoration-bf="1"/>
                <field name="provider"/>
                <field name="environment" widget="badge"
                       decoration-warning="environment == 'test'"
                       decoration-success="environment == 'production'"/>
                <field name="transaction_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- ============================================================
         PAYMENT GATEWAY: ACTION
    ============================================================ -->
    <record id="action_payment_gateway" model="ir.actions.act_window">
        <field name="name">Payment Gateways</field>
        <field name="res_model">payment.gateway</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure your first payment gateway
            </p>
            <p>
                Payment gateways connect to external providers (Payme, Click, Uzum)
                for online payment processing.
            </p>
        </field>
    </record>

</odoo>
