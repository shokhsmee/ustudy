<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Payment Type Form View -->
    <record id="view_payment_type_form" model="ir.ui.view">
        <field name="name">cc.payment.type.form</field>
        <field name="model">cc.payment.type</field>
        <field name="arch" type="xml">
            <form string="Payment Type">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="direction"/>
                            <field name="type_category"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Description..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Payment Type Tree View -->
    <record id="view_payment_type_tree" model="ir.ui.view">
        <field name="name">cc.payment.type.list</field>
        <field name="model">cc.payment.type</field>
        <field name="arch" type="xml">
            <list string="Payment Types" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="direction"/>
                <field name="type_category"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    
    <!-- Payment Type Action -->
    <record id="action_payment_type" model="ir.actions.act_window">
        <field name="name">Payment Types</field>
        <field name="res_model">cc.payment.type</field>
        <field name="view_mode">list,form</field>
    </record>
    
</odoo>