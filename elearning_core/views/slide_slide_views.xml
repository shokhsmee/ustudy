<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_slide_slide_form_elearning_core" model="ir.ui.view">
        <field name="name">slide.slide.form.elearning.core</field>
        <field name="model">slide.slide</field>
        <field name="inherit_id" ref="website_slides.view_slide_slide_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='external_links']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='quiz']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
