<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dars_jadvali_booking_form" model="ir.ui.view">
        <field name="name">dars.jadvali.booking.form</field>
        <field name="model">dars.jadvali.booking</field>
        <field name="arch" type="xml">
            <form string="Xona band qilish">
                <sheet>
                    <group>
                        <group>
                            <field name="purpose" widget="radio" options="{'horizontal': true}"/>
                            <field name="room_id" options="{'no_create': True}"/>
                            <field name="note"/>
                        </group>
                        <group>
                            <field name="start_datetime"/>
                            <field name="end_datetime"/>
                            <field name="user_id"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="Saqlash" special="save" class="btn-primary"/>
                    <button name="action_delete_booking" string="Bandni bekor qilish"
                            type="object" class="btn-danger"
                            confirm="Xona bandi o'chirilsinmi?"/>
                    <button string="Yopish" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_dars_jadvali_booking_list" model="ir.ui.view">
        <field name="name">dars.jadvali.booking.list</field>
        <field name="model">dars.jadvali.booking</field>
        <field name="arch" type="xml">
            <list>
                <field name="purpose"/>
                <field name="room_id"/>
                <field name="start_datetime"/>
                <field name="end_datetime"/>
                <field name="note"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>
</odoo>
