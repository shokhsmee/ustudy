<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dars_jadvali_lesson_wizard_form" model="ir.ui.view">
        <field name="name">dars.jadvali.lesson.wizard.form</field>
        <field name="model">dars.jadvali.lesson.wizard</field>
        <field name="arch" type="xml">
            <form string="Guruh darsi">
                <sheet>
                    <div class="oe_title">
                        <h2><field name="group_id" readonly="1"/></h2>
                    </div>
                    <group>
                        <group string="Guruh ma'lumotlari">
                            <field name="course_id" readonly="1"/>
                            <field name="teacher_id" readonly="1"/>
                            <field name="room_id" readonly="1"/>
                            <field name="state" readonly="1"/>
                            <field name="start_date" readonly="1"/>
                            <field name="end_date" readonly="1"/>
                            <field name="lesson_start" widget="float_time" readonly="1"/>
                            <field name="lesson_end" widget="float_time" readonly="1"/>
                        </group>
                        <group string="Reja / Fakt">
                            <field name="lessons_reja"/>
                            <field name="lessons_fakt"/>
                            <field name="lessons_pct"/>
                            <field name="probniy"/>
                            <field name="capacity"/>
                            <field name="student_count"/>
                            <field name="seats_pct"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Tanlangan davr darslari">
                            <field name="timetable_ids" readonly="1">
                                <list>
                                    <field name="lesson_sequence" string="No."/>
                                    <field name="start_datetime" string="Boshlanishi"/>
                                    <field name="end_datetime" string="Tugashi"/>
                                    <field name="slide_id" string="Dars/Slayd"/>
                                    <field name="room_id"/>
                                    <field name="teacher_id"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'completed'"
                                           decoration-info="state == 'in_progress'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_open_group" string="Guruhni ochish" type="object" class="btn-primary"/>
                    <button string="Yopish" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_dars_jadvali_add_lesson_wizard_form" model="ir.ui.view">
        <field name="name">dars.jadvali.add.lesson.wizard.form</field>
        <field name="model">dars.jadvali.add.lesson.wizard</field>
        <field name="arch" type="xml">
            <form string="Xonani band qilish">
                <sheet>
                    <group>
                        <group>
                            <field name="dars_only" invisible="1"/>
                            <field name="purpose" widget="radio" options="{'horizontal': true}"
                                   invisible="dars_only"/>
                            <field name="group_id" options="{'no_create': True}"
                                   invisible="purpose != 'dars'"
                                   required="purpose == 'dars'"/>
                            <field name="teacher_id" options="{'no_create': True}"
                                   invisible="purpose != 'dars'"/>
                            <field name="room_id" options="{'no_create': True}"/>
                            <field name="note" invisible="purpose == 'dars'"
                                   placeholder="Masalan: ota-onalar bilan majlis"/>
                        </group>
                        <group>
                            <field name="lesson_date"/>
                            <field name="start_time" widget="float_time"/>
                            <field name="end_time" widget="float_time"/>
                            <field name="repeat_weekly" invisible="purpose == 'dars' or dars_only"/>
                            <field name="repeat_until"
                                   invisible="purpose == 'dars' or dars_only or not repeat_weekly"
                                   required="repeat_weekly and purpose != 'dars'"/>
                        </group>
                    </group>
                    <!-- single-day booking: which parity block the date falls in,
                         the picked day green (Du Chor Jum / Se Pay Shan) -->
                    <div class="mt-2" invisible="repeat_weekly or not lesson_date">
                        <label for="day_block_preview" string="Dars kunlari"/>
                        <field name="day_block_preview" nolabel="1" readonly="1"/>
                    </div>
                </sheet>
                <footer>
                    <button name="action_add_lesson" string="Band qilish" type="object" class="btn-primary"/>
                    <button string="Bekor qilish" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
