<odoo>
    <record id="view_edu_group_add_student_wizard_form" model="ir.ui.view">
        <field name="name">edu.group.add.student.wizard.form</field>
        <field name="model">edu.group.add.student.wizard</field>
        <field name="arch" type="xml">
            <form string="Guruhga O'quvchi Qo'shish">
                <field name="can_join" invisible="1"/>
                <field name="max_join_lesson" invisible="1"/>
                <field name="lessons_until_next_module" invisible="1"/>

                <div class="alert alert-warning mb-2"
                     role="alert"
                     invisible="can_join">
                    <i class="fa fa-exclamation-triangle me-2" title="Warning" role="img" aria-label="Warning"/>
                    <strong>Diqqat!</strong> Joriy modulda
                    <field name="module_lesson_offset" class="oe_inline fw-bold" readonly="1" nolabel="1"/>
                    ta dars o'tib bo'lgan. Yangi o'quvchini faqat modulning birinchi
                    <field name="max_join_lesson" class="oe_inline fw-bold" readonly="1" nolabel="1"/>
                    ta darsi ichida qo'shish mumkin. Keyingi modulgacha
                    <field name="lessons_until_next_module" class="oe_inline fw-bold" readonly="1" nolabel="1"/>
                    ta dars qoldi.
                </div>

                <group>
                    <group string="O'quvchi ma'lumotlari">
                        <field name="group_id" readonly="1"/>
                        <field name="student_id"
                               options="{'no_create': True}"
                               placeholder="O'quvchini tanlang..."/>
                        <field name="enrollment_date"/>
                    </group>
                    <group string="Modul hisobi (avtomatik)">
                        <field name="lessons_before_join" readonly="1"/>
                        <field name="starting_module_id" readonly="1"/>
                        <field name="module_lesson_offset" readonly="1"/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirm"
                            string="Guruhga qo'shish"
                            type="object"
                            class="btn-primary"
                            invisible="not can_join"/>
                    <button string="Bekor qilish"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
