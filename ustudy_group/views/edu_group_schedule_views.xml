<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- SCHEDULE LINE: LIST VIEW -->
    <record id="view_edu_group_schedule_list" model="ir.ui.view">
        <field name="name">edu.group.schedule.list</field>
        <field name="model">edu.group.schedule</field>
        <field name="arch" type="xml">
            <list string="Schedule">
                <field name="group_id"/>
                <field name="weekday_id"/>
                <field name="time_from" widget="float_time"/>
                <field name="time_to" widget="float_time"/>
                <field name="duration"/>
                <field name="room_id" optional="show"/>
                <field name="teacher_id" widget="many2one_avatar_user" optional="show"/>
            </list>
        </field>
    </record>

    <!-- SCHEDULE LINE: FORM VIEW -->
    <record id="view_edu_group_schedule_form" model="ir.ui.view">
        <field name="name">edu.group.schedule.form</field>
        <field name="model">edu.group.schedule</field>
        <field name="arch" type="xml">
            <form string="Schedule Slot">
                <sheet>
                    <group>
                        <group string="Time">
                            <field name="group_id" readonly="1"/>
                            <field name="weekday_id"/>
                            <field name="time_from" widget="float_time"/>
                            <field name="time_to" widget="float_time"/>
                            <field name="duration" readonly="1"/>
                        </group>
                        <group string="Resources">
                            <field name="room_id"/>
                            <field name="teacher_id" widget="many2one_avatar_user"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_edu_group_schedule" model="ir.actions.act_window">
        <field name="name">Schedule</field>
        <field name="res_model">edu.group.schedule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
