<!-- ustudy_group/views/edu_group_views.xml - UPDATED FOR MODULE PAYMENT SYSTEM -->
<odoo>
    <!-- GROUP LIST VIEW -->
    <record id="view_edu_group_list" model="ir.ui.view">
        <field name="name">edu.group.list</field>
        <field name="model">edu.group</field>
        <field name="arch" type="xml">
            <list string="Groups" sample="1" js_class="group_dashboard_list">
                <field name="name" decoration-bf="1"/>
                <field name="course_id"/>
                <field name="teacher_id" widget="many2one_avatar_user"/>
                <field name="student_count"/>
                <field name="lesson_room" optional="hide"/>
                <field name="company_id" optional="hide"/>
                <field name="state" widget="badge" 
                    decoration-success="state == 'running'"
                    decoration-info="state == 'draft'"
                    decoration-muted="state == 'done'"
                    decoration-danger="state == 'cancelled'"/>
                <field name="start_date"/>
                <field name="end_date"/>
            </list>
        </field>
    </record>


    <!-- STUDENT LINE LIST VIEW (standalone) — layout matches the "O'quvchilar" design -->
    <record id="view_edu_group_student_list" model="ir.ui.view">
        <field name="name">edu.group.student.list</field>
        <field name="model">edu.group.student</field>
        <field name="arch" type="xml">
            <list string="O'quvchilar"
                decoration-success="state == 'active' and debt_status == 'paid'"
                decoration-info="state == 'completed'"
                decoration-danger="state == 'frozen' or debt_status == 'debtor'"
                decoration-muted="state == 'cancelled'">

                <field name="student_id" string="Ism" widget="many2one_avatar"/>

                <field name="state"
                    string="Status"
                    widget="badge"
                    decoration-success="state == 'active'"
                    decoration-info="state == 'completed'"
                    decoration-warning="state == 'frozen'"
                    decoration-danger="state == 'cancelled'"/>

                <field name="group_id" string="Guruh"/>
                <field name="current_module_id" string="Joriy modul"/>

                <field name="passed_lessons_count" string="O'tilingan darslar"/>
                <field name="passed_lessons_amount"
                       string="O'tilgan darslar summasi"
                       widget="monetary"
                       optional="hide"/>
                <field name="current_module_paid" widget="boolean_toggle"/>
                <field name="student_balance"
                       string="O'quvchi balans"
                       widget="monetary"/>

                <field name="davomat_ratio" string="Davomati"/>
                <field name="debt_status"
                       string="To'lov holati"
                       widget="badge"
                       decoration-success="debt_status == 'paid'"
                       decoration-danger="debt_status == 'debtor'"/>
                <!-- Vazifa holati column is injected by ustudy_homework via view inherit. -->

                <!-- Optional / hidden by default -->
                <field name="enrollment_date" optional="hide"/>
                <field name="starting_module_id" optional="hide"/>
                <field name="lessons_in_current_module" optional="hide"/>
                <field name="payment_status"
                       widget="badge"
                       optional="hide"
                       decoration-success="payment_status == 'paid'"
                       decoration-danger="payment_status == 'overdue'"
                       decoration-info="payment_status == 'not_started'"/>
                <field name="current_module_payment_amount" widget="monetary" optional="hide"/>
                <field name="module_price" widget="monetary" optional="hide"/>
                <field name="total_courses" optional="hide"/>

                <button name="action_register_module_payment"
                        type="object"
                        string="Pay"
                        icon="fa-money"
                        class="btn-primary"
                        invisible="1"/>
            </list>
        </field>
    </record>

    <!-- SEARCH VIEW for edu.group.student standalone list -->
    <record id="view_edu_group_student_search" model="ir.ui.view">
        <field name="name">edu.group.student.search</field>
        <field name="model">edu.group.student</field>
        <field name="arch" type="xml">
            <search string="O'quvchilarni qidirish">
                <field name="student_id" string="O'quvchi"/>
                <field name="group_id" string="Guruh"/>
                <field name="current_module_id" string="Modul"/>

                <separator/>
                <filter string="Faol" name="state_active"
                        domain="[('state', '=', 'active')]"/>
                <filter string="Muzlatilgan" name="state_frozen"
                        domain="[('state', '=', 'frozen')]"/>
                <filter string="Tugatgan" name="state_completed"
                        domain="[('state', '=', 'completed')]"/>
                <filter string="Bekor qilingan" name="state_cancelled"
                        domain="[('state', '=', 'cancelled')]"/>

                <separator/>
                <filter string="To'langan modul" name="paid"
                        domain="[('payment_status', '=', 'paid')]"/>
                <filter string="Qisman to'langan" name="partial"
                        domain="[('payment_status', '=', 'partial')]"/>
                <filter string="Muddati o'tgan" name="overdue"
                        domain="[('payment_status', '=', 'overdue')]"/>

                <separator/>
                <filter string="Guruh bo'yicha" name="group_by_group"
                        context="{'group_by': 'group_id'}"/>
                <filter string="Modul bo'yicha" name="group_by_module"
                        context="{'group_by': 'current_module_id'}"/>
                <filter string="Holat bo'yicha" name="group_by_state"
                        context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <!--
        Re-order Talabalar ro'yxati action to show LIST first (not kanban).
        Keep model as res.partner so the form view stays untouched (one row per
        student, even if they're enrolled in multiple groups). New columns are
        added via list-view inherit in ustudy_group/views/student_views.xml.
    -->
    <!--
        Search/filter view for the Talabalar list. Filters delegate to the
        roster_* search helpers on res.partner (see ustudy_group/models/
        res_partner.py): guruh / ustoz / kurs / kurs boshlanish sanasi go
        through the enrollment relation, and Qarzdor/Haqdor are matched on the
        student's primary-enrollment payment health.
    -->
    <record id="view_student_partner_search" model="ir.ui.view">
        <field name="name">res.partner.search.student</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search string="Talabalarni qidirish">
                <field name="name" string="Ism"/>
                <field name="phone"/>
                <field name="roster_group_id" string="Guruh"/>
                <field name="roster_teacher_id" string="Ustoz"/>
                <field name="roster_direction_id" string="Kurs"/>
                <field name="roster_course_start_date" string="Kurs boshlanish sanasi"/>

                <separator/>
                <filter string="Qarzdor" name="debtor"
                        domain="[('roster_payment_health', '=', 'debtor')]"/>
                <filter string="Haqdor" name="paid"
                        domain="[('roster_payment_health', '=', 'paid')]"/>

                <!-- Click-to-select sidebar: pick a course and/or tick groups
                     to filter the list (counters show students per item).
                     Backed by the stored primary_* fields on res.partner. -->
                <searchpanel>
                    <field name="primary_course_id" string="Yo'nalish"
                           icon="fa-graduation-cap" enable_counters="1"/>
                    <field name="primary_group_id" string="Guruh" select="multi"
                           icon="fa-users" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="ustudy_student.action_student_contacts" model="ir.actions.act_window">
        <field name="res_model">res.partner</field>
        <field name="domain">[('is_student','=',True)]</field>
        <field name="context">{'default_is_student': True, 'search_default_is_student': 1}</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_student_partner_search"/>
        <!-- Rebuild the view bindings explicitly. They were lost on a previous
             upgrade (action had view_mode 'kanban,form' and no view_ids), which
             dropped the list view entirely. (5,0,0) clears, then re-creates. -->
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'sequence': 1, 'view_mode': 'list',   'view_id': ref('ustudy_student.view_student_partner_list')}),
            (0, 0, {'sequence': 2, 'view_mode': 'kanban', 'view_id': ref('ustudy_student.view_student_partner_kanban')}),
            (0, 0, {'sequence': 3, 'view_mode': 'form',   'view_id': ref('ustudy_student.view_student_partner_form')})
        ]"/>
    </record>

    <!--
        Force the Talabalar menu back onto the student (res.partner) action.
        A previous version of this module repointed this menu to a temporary
        action that was later removed; because the menu is owned by
        ustudy_student, deleting that action left the menu dangling. Setting the
        action explicitly here repairs it on upgrade.
    -->
    <menuitem id="ustudy_student.ustudy_student_menu_students"
              name="Talabalar ro'yxati"
              parent="ustudy_student.ustudy_student_menu_root"
              action="ustudy_student.action_student_contacts"
              sequence="10"/>

    <!-- GROUP FORM VIEW -->
    <record id="view_edu_group_form" model="ir.ui.view">
        <field name="name">edu.group.form</field>
        <field name="model">edu.group</field>
        <field name="arch" type="xml">
            <form string="Group">
                <header>
                    <!-- State Management Buttons -->
                    <button name="action_start" 
                            string="Start Course" 
                            type="object" 
                            class="oe_highlight"
                            invisible="state == 'running'"
                            groups="base.group_user,!ustudy_group.group_teacher"/>
                    
                    <button name="action_complete" 
                            string="Mark as Done" 
                            type="object"
                            invisible="state != 'running'"
                            groups="base.group_user,!ustudy_group.group_teacher"/>
                    
                    <button name="action_add_student_midgroup"
                            string="Guruhga o'quvchi qo'shish"
                            type="object"
                            class="btn-success"
                            invisible="state != 'running' or not can_add_student_now"
                            groups="base.group_user,!ustudy_group.group_teacher"/>

                    <button name="action_generate_or_regenerate_timetable"
                            string="Generate Timetable"
                            type="object"
                            class="btn-primary"
                            invisible="state not in ['draft', 'running']"
                            groups="base.group_user,!ustudy_group.group_teacher"/>
                    
                    <field name="state" widget="statusbar" clickable="True" statusbar_visible="draft,running,done"
                           groups="!ustudy_group.group_teacher"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,running,done"
                           groups="ustudy_group.group_teacher"/>
                </header>
                
                <sheet>
                    <!-- Mini dashboard: KPI cards shown before the buttons -->
                    <div class="o_group_mini_dashboard">
                        <div class="o_group_kpi_card">
                            <div class="o_group_kpi_label">Aktiv o'quvchilar</div>
                            <div class="o_group_kpi_value">
                                <field name="active_student_count" nolabel="1" readonly="1"/>
                            </div>
                        </div>
                        <div class="o_group_kpi_card">
                            <div class="o_group_kpi_label">Davomat</div>
                            <div class="o_group_kpi_value">
                                <field name="attendance_display" nolabel="1" readonly="1"/>
                            </div>
                        </div>
                        <div class="o_group_kpi_card">
                            <div class="o_group_kpi_label">Vazifa ko'rsatkichi</div>
                            <div class="o_group_kpi_value">
                                <field name="homework_display" nolabel="1" readonly="1"/>
                            </div>
                        </div>
                        <div class="o_group_kpi_card">
                            <div class="o_group_kpi_label">Qarzdorlar jami</div>
                            <div class="o_group_kpi_value o_group_kpi_value_sm">
                                <field name="debt_total_display" nolabel="1" readonly="1"/>
                            </div>
                        </div>
                        <div class="o_group_kpi_card">
                            <div class="o_group_kpi_label">To'xtatgan o'quvchilar</div>
                            <div class="o_group_kpi_value">
                                <field name="stopped_student_count" nolabel="1" readonly="1"/>
                            </div>
                        </div>
                    </div>

                    <!-- Smart Buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_students" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-users">
                            <field name="student_count" widget="statinfo" string="Students"/>
                        </button>
                        
                        <button name="action_view_lessons" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-book">
                            <field name="course_count" widget="statinfo" string="Lessons"/>
                        </button>
                        
                        <button name="action_view_timetable" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-calendar">
                            <field name="timetable_count" widget="statinfo" string="Timetable"/>
                        </button>

                        <button name="action_view_group_homeworks"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-tasks">
                            <field name="homework_timetable_count" widget="statinfo" string="Topshiriqlar"/>
                        </button>

                        <button name="action_view_group_attendance_timeline"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-clock-o">
                            <field name="attendance_count" widget="statinfo" string="Davomat"/>
                        </button>

                    </div>

                    
                    
                    <!-- Title -->
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <field name="teacher_readonly" invisible="1"/>
                    <field name="timetable_count" invisible="1"/>
                    <field name="can_add_student_now" invisible="1"/>
                    <field name="max_join_lesson" invisible="1"/>
                    <field name="lessons_into_current_module" invisible="1"/>
                    <field name="lessons_until_next_module" invisible="1"/>

                    <!-- Banner: tell admin why "Add student" is hidden and when it'll come back. -->
                    <div class="alert alert-info mb-2"
                         role="alert"
                         invisible="state != 'running' or can_add_student_now">
                        <i class="fa fa-info-circle me-2" title="Info" role="img" aria-label="Info"/>
                        <strong>Yangi o'quvchi qo'shish hozir mumkin emas.</strong>
                        Joriy modulda
                        <field name="lessons_into_current_module" class="oe_inline fw-bold" readonly="1" nolabel="1"/>
                        ta dars o'tib bo'lgan — o'quvchi faqat modulning birinchi
                        <field name="max_join_lesson" class="oe_inline fw-bold" readonly="1" nolabel="1"/>
                        ta darsi ichida qo'shiladi. Keyingi modul boshlanishigacha
                        <field name="lessons_until_next_module" class="oe_inline fw-bold" readonly="1" nolabel="1"/>
                        ta dars qoldi.
                    </div>

                    <!-- Banner: green confirmation while joining is still open -->
                    <div class="alert alert-success mb-2"
                         role="alert"
                         invisible="state != 'running' or not can_add_student_now">
                        <i class="fa fa-check-circle me-2" title="Ready" role="img" aria-label="Ready"/>
                        Joriy modulda
                        <field name="lessons_into_current_module" class="oe_inline fw-bold" readonly="1" nolabel="1"/>
                        ta dars o'tilgan. Hozir yangi o'quvchi qo'shish mumkin
                        (modulning birinchi
                        <field name="max_join_lesson" class="oe_inline fw-bold" readonly="1" nolabel="1"/>
                        ta darsi ichida).
                    </div>
                    
                    <div class="oe_title">
                        <label for="name" string="Group Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Python P14" required="1" readonly="teacher_readonly"/>
                        </h1>
                    </div>

                    <!-- Main Information -->
                    <group>
                        <group string="Course Information">
                            <field name="course_id"
                                   options="{'no_create': True}"
                                   required="1"
                                   readonly="teacher_readonly"/>
                            <field name="slide_channel_id" readonly="1"/>
                            <field name="teacher_id"
                                   widget="many2one_avatar_user"
                                   readonly="teacher_readonly"/>
                            <field name="extra_teacher_id"
                                   widget="many2one_avatar_user"
                                   readonly="teacher_readonly"/>

                            <field name="lesson_room"
                                   options="{'no_create': True}"
                                   readonly="teacher_readonly"/>
                            <field name="group_color" widget="color_picker" readonly="teacher_readonly"/>
                        </group>
                        
                        <group string="Schedule">
                            <field name="start_date" string="Guruh boshlanish sanasi" required="1"
                                   readonly="teacher_readonly"
                                   help="ERP joriy qilish sanasini qo'ygan ma'qul. Agar ancha oldin boshlangan darsning sanasini yozsangiz, o'tib ketgan barcha ma'lumotlarni (davomat, topshiriqlar va boshqalarni) qo'lda to'ldirib chiqishga to'g'ri keladi."/>
                            <field name="start_lesson_number" string="Boshlangan dars"
                                   readonly="teacher_readonly"
                                   help="Shu sanadan boshlab nechinchi dars o'tiladi."/>
                            <field name="lesson_count" string="Jami darslar soni" placeholder="Darslar soni"
                                   readonly="teacher_readonly"
                                   help="Guruh dasturidagi standart/rejalashtirilgan darslar soni."/>
                            <label for="end_date" string="Tugash sanasi"/>
                            <div class="o_row">
                                <field name="end_date" class="oe_inline" nolabel="1" readonly="1"/>
                            </div>

                            <label for="lesson_start" string="Lesson Time"/>
                            <div class="o_row">
                                <field name="lesson_start"
                                    widget="float_time"
                                    class="oe_inline"
                                    nolabel="1"
                                    required="1"
                                    readonly="teacher_readonly"/>
                                <i class="fa fa-long-arrow-right mx-2 oe_edit_only" aria-label="Arrow icon" title="Arrow"/>
                                <span class="mx-2 oe_read_only">→</span>
                                <field name="lesson_end"
                                    widget="float_time"
                                    class="oe_inline"
                                    nolabel="1"
                                    required="1"
                                    readonly="teacher_readonly"/>
                            </div>
                            <field name="lesson_days"
                                   widget="many2many_tags"
                                   options="{'color_field': 'sequence', 'no_create': True}"
                                   placeholder="Select lesson days..."
                                   readonly="teacher_readonly"/>
                        </group>
                    </group>

                    <!-- Notebook -->
                    <notebook>
                        <!-- Students Tab - layout matches the "O'quvchilar" design:
                             Ism · Status · Joriy modul · O'tilingan darslar ·
                             O'tilgan darslar summasi · O'quvchi balans · Davomati · Vazifa holati. -->
                        <page string="Students" name="students">
                            <field name="student_line_ids" readonly="teacher_readonly">
                                <!-- create="false": students join ONLY through the
                                     "Guruhga o'quvchi qo'shish" wizard, never by
                                     adding a raw line here. -->
                                <list editable="bottom" create="false" string="O'quvchilar"
                                      decoration-success="state == 'active' and debt_status == 'paid'"
                                      decoration-info="state == 'completed'"
                                      decoration-danger="state == 'frozen' or debt_status == 'debtor'"
                                      decoration-muted="state == 'cancelled'">

                                    <field name="student_id"
                                           string="Ism"
                                           widget="many2one_avatar"
                                           domain="[('is_student', '=', True)]"/>

                                    <field name="state"
                                           string="Status"
                                           widget="badge"
                                           decoration-success="state == 'active'"
                                           decoration-info="state == 'completed'"
                                           decoration-warning="state == 'frozen'"
                                           decoration-danger="state == 'cancelled'"/>

                                    <field name="current_module_id" string="Joriy modul"/>

                                    <field name="passed_lessons_count" string="O'tilingan darslar"/>
                                    <field name="passed_lessons_amount"
                                           string="O'tilgan darslar summasi"
                                           widget="monetary"
                                           optional="hide"/>
                                    <field name="paid_lessons_count" optional="show"/>

                                    <field name="debt_lessons_count" string="Qarz darslar" optional="show"/>
                                    
                                    <field name="student_balance"
                                           string="O'quvchi balans"
                                           widget="monetary"/>

                                    <field name="davomat_ratio" string="Davomati"/>
                                    <field name="debt_status"
                                           string="To'lov holati"
                                           widget="badge"
                                           decoration-success="debt_status == 'paid'"
                                           decoration-danger="debt_status == 'debtor'"/>

                                    <!-- Optional columns kept available but hidden by default -->
                                    <field name="starting_module_id" optional="hide"/>
                                    <field name="lessons_in_current_module" optional="hide"/>
                                    <field name="paid_amount_total" widget="monetary" optional="hide"/>
                                    <field name="attended_lessons_count" optional="hide"/>
                                    <field name="enrollment_date" optional="hide"/>
                                    <field name="payment_status"
                                           widget="badge"
                                           optional="hide"
                                           decoration-success="payment_status == 'paid'"
                                           decoration-danger="payment_status == 'overdue'"
                                           decoration-info="payment_status == 'not_started'"/>
                                    <field name="current_module_payment_amount"
                                           widget="monetary"
                                           optional="hide"/>
                                    <field name="module_price"
                                           widget="monetary"
                                           optional="hide"/>
                                    <field name="current_module_paid"
                                           widget="boolean_toggle"
                                           optional="hide"/>
                                    <field name="total_courses" optional="hide"/>

                                    <!-- Payment Button (hidden — kept for backwards compat) -->
                                    <button name="action_register_module_payment"
                                            type="object"
                                            string="Pay"
                                            icon="fa-money"
                                            class="btn-primary"
                                            invisible="1"/>
                                </list>
                            </field>
                        </page>
                        
                        <!-- Notes/Description Tab -->
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Add any additional notes or description for this group..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- STUDENT LINE FORM VIEW (opened from group) -->
    <record id="view_edu_group_student_form" model="ir.ui.view">
        <field name="name">edu.group.student.form</field>
        <field name="model">edu.group.student</field>
        <field name="arch" type="xml">
            <form string="Group Student">
                <header>
                    <button name="action_register_module_payment" 
                            string="Register Module Payment" 
                            type="object" 
                            class="btn-primary"
                            invisible="1"/>
                    <field name="state" widget="statusbar" 
                           statusbar_visible="active,completed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_student_finance"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-money">
                            <field name="finance_count" widget="statinfo" string="Payments"/>
                        </button>
                    </div>
                    <group>
                        <group string="Student Information">
                            <field name="student_id"
                                   options="{'no_create': True}"/>
                            <field name="student_name" readonly="1"/>
                            <field name="group_id"
                                   options="{'no_create': True}"/>
                            <field name="enrollment_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Module Progress">
                            <field name="starting_module_id" readonly="1"/>
                            <field name="current_module_id" readonly="1"/>
                            <field name="lessons_in_current_module" readonly="1"/>
                            <field name="payment_status"
                                   decoration-danger="payment_status == 'overdue'"
                                   decoration-warning="payment_status == 'partial'"
                                   decoration-success="payment_status == 'paid'"
                                   widget="badge"/>
                        </group>
                    </group>
                    <group>
                        <group string="Payment Information">
                            <label for="current_module_payment_amount"/>
                            <div class="o_row">
                                <field name="current_module_payment_amount" 
                                       widget="monetary" 
                                       readonly="1"
                                       nolabel="1"/>
                                <span> / </span>
                                <field name="module_price" 
                                       widget="monetary" 
                                       readonly="1"
                                       nolabel="1"/>
                            </div>
                            <field name="current_module_paid" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- GROUP SEARCH VIEW -->
    <record id="view_edu_group_search" model="ir.ui.view">
        <field name="name">edu.group.search</field>
        <field name="model">edu.group</field>
        <field name="arch" type="xml">
            <search string="Guruhlarni qidirish">

                <!-- Search fields -->
                <field name="name" string="Guruh nomi"/>
                <field name="student_line_ids" string="O'quvchi"
                       filter_domain="[('student_line_ids.student_id', 'ilike', self)]"/>
                <field name="teacher_id" string="O'qituvchi"/>
                <field name="extra_teacher_id" string="Mentor"/>
                <field name="course_id" string="Kurs"/>
                <field name="start_date" string="Boshlanish sanasi"/>
                <field name="lesson_days" string="Hafta kuni"/>

                <!-- Status filters -->
                <separator/>
                <filter string="Faol" name="state_running"
                        domain="[('state', '=', 'running')]"/>
                <filter string="Qoralama" name="state_draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Tugallangan" name="state_done"
                        domain="[('state', '=', 'done')]"/>
                <filter string="Bekor qilingan" name="state_cancelled"
                        domain="[('state', '=', 'cancelled')]"/>

                <!-- Group By -->
                <separator/>
                <filter string="O'qituvchi" name="group_by_teacher"
                        context="{'group_by': 'teacher_id'}"/>
                <filter string="Mentor" name="group_by_mentor"
                        context="{'group_by': 'extra_teacher_id'}"/>
                <filter string="Holat" name="group_by_state"
                        context="{'group_by': 'state'}"/>
                <filter string="Kurs" name="group_by_course"
                        context="{'group_by': 'course_id'}"/>
            </search>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_edu_group" model="ir.actions.act_window">
        <field name="name">Groups</field>
        <field name="res_model">edu.group</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_edu_group_search"/>
        <field name="context">{'search_default_state_running': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first student group
            </p>
            <p>
                Groups are used to organize students by course, schedule lessons,
                and track their progress.
            </p>
        </field>
    </record>

</odoo>