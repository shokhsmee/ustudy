<!-- ustudy_group/views/student_views.xml -->
<odoo>
    <!--
        Inherit the Talabalar list view (defined in ustudy_student) and replace
        its column set with the O'quvchilar layout: Ism · Status · Joriy modul ·
        O'tilingan darslar · Summasi · O'quvchi balans · Davomati · (Vazifa
        holati column is added by ustudy_homework inherit).

        Stays at the res.partner level (one row per student) — students in
        multiple groups still appear once; their group breakdown lives in the
        "Guruhlar" tab on the form view.
    -->
    <record id="view_student_partner_list_inherit" model="ir.ui.view">
        <field name="name">res.partner.list.student.ustudy_group.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="ustudy_student.view_student_partner_list"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="replace">
                <list string="O'quvchilar" create="1" edit="1" delete="0" limit="50"
                      decoration-danger="roster_lesson_balance &lt; 0"
                      decoration-success="roster_lesson_balance &gt; 0">
                    <field name="name" string="Ism"/>
                    <field name="roster_course_start_date" string="Kurs boshlangan sana"/>
                    <field name="roster_course_end_date" string="Kurs tugash sanasi"/>
                    <field name="roster_direction_id" string="Yo'nalish"/>
                    <field name="roster_group_id" string="Guruhi"/>
                    <field name="roster_teacher_id" string="Ustozi"/>
                    <field name="roster_current_module_id" string="Joriy modul"/>
                    <field name="roster_current_lesson_no" string="Joriy dars"/>
                    <field name="roster_paid_lessons" string="To'langan darslar soni"/>
                    <field name="roster_payment_health"
                           string="To'lov holati"
                           widget="badge"
                           decoration-danger="roster_payment_health == 'debtor'"
                           decoration-success="roster_payment_health == 'paid'"/>
                    <field name="roster_lesson_balance"
                           string="To'lov statusi"
                           decoration-danger="roster_lesson_balance &lt; 0"
                           decoration-success="roster_lesson_balance &gt; 0"/>
                    <!-- "Vazifa holati" column injected by ustudy_homework after davomat_summary. -->

                    <!-- Optional, hidden -->
                    <field name="student_status_summary" string="Status" optional="hide"/>
                    <field name="current_module_summary" string="Joriy modul (barcha)" optional="hide"/>
                    <field name="passed_lessons_total" string="O'tilingan darslar" optional="hide"/>
                    <field name="passed_lessons_amount_total"
                           string="O'tilgan darslar summasi"
                           widget="monetary" optional="hide"/>
                    <field name="student_balance"
                           string="O'quvchi balans"
                           widget="monetary" optional="hide"/>
                    <field name="davomat_summary" string="Davomati" optional="hide"/>
                    <field name="phone" optional="hide"/>
                    <field name="email" optional="hide"/>
                    <field name="state_id" string="Viloyat" optional="hide"/>
                    <field name="cc_region_id" string="Tuman" optional="hide"/>
                    <field name="total_courses" string="Kurslar" optional="hide"/>
                </list>
            </xpath>
        </field>
    </record>

    <!--
        Add a "Guruhlar" tab to the partner form so a student in 2 groups can
        see both enrollments and their per-group module/davomat numbers.
    -->
    <record id="view_student_partner_form_guruhlar_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.student.guruhlar.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="ustudy_student.view_student_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Guruhlar" name="guruhlar"
                      invisible="not is_student">
                    <field name="group_student_ids">
                        <list string="Guruhlar" create="0" edit="0" delete="0">
                            <field name="group_id" string="Guruh"/>
                            <field name="state" string="Holat" widget="badge"
                                   decoration-success="state == 'active'"
                                   decoration-info="state == 'completed'"
                                   decoration-warning="state == 'frozen'"
                                   decoration-danger="state == 'cancelled'"/>
                            <field name="enrollment_date" string="Qo'shilgan sana"/>
                            <field name="starting_module_id" string="Boshlangan modul"/>
                            <field name="current_module_id" string="Joriy modul"/>
                            <field name="passed_lessons_count" string="O'tilingan darslar"/>
                            <field name="passed_lessons_amount"
                                   string="O'tilgan darslar summasi"
                                   widget="monetary"/>
                            <field name="davomat_ratio" string="Davomati"/>
                            <!-- vazifa_ratio column injected by ustudy_homework -->
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- LIST VIEW OF STUDENTS (legacy, unused by menu — kept for back-compat) -->
    <record id="view_student_list" model="ir.ui.view">
        <field name="name">res.partner.student.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Students">
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="total_courses"/>
                <field name="avg_progress"/>
                <field name="avg_mark"/>
            </list>
        </field>
    </record>

    <!-- KANBAN VIEW OF STUDENTS -->
    <record id="view_student_kanban" model="ir.ui.view">
        <field name="name">res.partner.student.kanban</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="total_courses"/>
                <field name="avg_progress"/>
                <field name="avg_mark"/>

                <templates>
                    <t t-name="kanban-box">
                        <div class="o_kanban_record">
                            <div class="o_kanban_image">
                                <img t-att-src="kanban_image('res.partner', 'image_128', record.id.raw_value)"/>
                            </div>
                            <div class="o_kanban_details">
                                <strong t-esc="record.name.value"/>
                                <div t-if="record.email.value">
                                    <span t-esc="record.email.value"/>
                                </div>
                                <div t-if="record.phone.value">
                                    <span t-esc="record.phone.value"/>
                                </div>
                                <div>
                                    Courses:
                                    <span t-esc="record.total_courses.value"/>
                                </div>
                                <div>
                                    Avg progress:
                                    <span t-esc="record.avg_progress.value"/>%
                                </div>
                                <div>
                                    Avg mark:
                                    <span t-esc="record.avg_mark.value"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
