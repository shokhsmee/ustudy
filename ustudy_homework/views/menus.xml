<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- SETTINGS: Course pass ball -->
  <record id="action_homework_course_settings" model="ir.actions.act_window">
    <field name="name">Sozlamalar</field>
    <field name="res_model">slide.channel</field>
    <field name="view_mode">list,form</field>
  </record>

  <!-- Assignments: list of homeworks, grouped by course by default -->
  <record id="action_edu_homework_list" model="ir.actions.act_window">
    <field name="name">Vazifalar</field>
    <field name="res_model">edu.homework</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'group_by': 'channel_id'}</field>
  </record>

  <!-- Marks: submissions -->
  <record id="action_edu_homework_submissions" model="ir.actions.act_window">
    <field name="name">Marks</field>
    <field name="res_model">edu.homework.submission</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="view_edu_homework_submission_tree"/>
    <field name="search_view_id" ref="view_edu_homework_submission_search"/>
    <field name="context">{ "search_default_not_graded": 1 }</field>
  </record>

  <!-- Top-level menu for Homeworks -->
  <menuitem id="menu_ustudy_homework_root"
            name="Vazifalar"
            sequence="95"
            web_icon="ustudy_homework,static/icon.png"/>

  <menuitem id="menu_ustudy_homework_manage"
            name="Assignments"
            parent="menu_ustudy_homework_root"
            action="action_edu_homework_list"
            sequence="1"/>

  <menuitem id="menu_ustudy_homework_marks"
            name="Marks"
            parent="menu_ustudy_homework_root"
            action="action_edu_homework_submissions"
            sequence="2"/>

  <menuitem id="menu_ustudy_homework_settings"
            name="Sozlamalar"
            parent="menu_ustudy_homework_root"
            action="action_homework_course_settings"
            sequence="3"/>

</odoo>
