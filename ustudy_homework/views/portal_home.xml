<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_my_home_lessons"
              inherit_id="portal.portal_my_home"
              name="Portal My Lessons Menu">

        <xpath expr="//div[contains(@class,'o_portal_my_home')]//div[contains(@class,'row')][1]"
               position="inside">

            <div class="col-12 col-md-6 mb-3">
                <a t-attf-href="/my/lessons"
                   class="d-flex align-items-center p-3 border rounded text-decoration-none shadow-sm bg-white">

                    <div class="me-3">
                        <i class="fa fa-calendar-check-o fa-2x text-primary"/>
                    </div>

                    <div class="flex-grow-1">
                        <h5 class="mb-1 fw-bold">Mening Vazifalarim</h5>
                        <p class="mb-0 text-muted small">
                            Darslar va vazifalarni ko‘rish
                        </p>
                    </div>

                    <div class="ms-auto text-end">
                        <span class="badge bg-primary">
                            <t t-esc="lesson_report_count if lesson_report_count else 0"/>
                        </span>
                    </div>

                </a>
            </div>

        </xpath>

    </template>

    <!--
        Hide the stock portal "Addresses" (Manzillar) and "Connection &
        Security" (Ulanish & Xavfsizlik) cards. They live alone in the
        #portal_common_category container (the Vazifalar/Hisobotlar cards are
        added to the parent row, not here), so hiding the container removes
        only those two.
    -->
    <template id="portal_my_home_hide_common"
              inherit_id="portal.portal_my_home"
              name="Hide Addresses &amp; Security cards">
        <xpath expr="//div[@id='portal_common_category']" position="attributes">
            <attribute name="class" add="d-none" separator=" "/>
        </xpath>
    </template>

</odoo>
