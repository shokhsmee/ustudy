<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <record id="view_edu_student_lesson_report_list" model="ir.ui.view">
        <field name="name">edu.student.lesson.report.list</field>
        <field name="model">edu.student.lesson.report</field>
        <field name="arch" type="xml">
            <list string="Vazifalar"
                create="0" edit="0" delete="0"
                js_class="lesson_report_dashboard_list">

                <field name="start_datetime"/>
                <field name="timetable_name"/>
                <field name="group_id"/>
                <field name="slide_id"/>

                <field name="timetable_state"
                    widget="badge"
                    decoration-info="timetable_state == 'scheduled'"
                    decoration-warning="timetable_state == 'in_progress'"
                    decoration-success="timetable_state == 'completed'"
                    decoration-danger="timetable_state == 'cancelled'"/>

                <field name="attendance_status"
                    widget="badge"
                    decoration-success="attendance_status == 'present'"
                    decoration-danger="attendance_status == 'absent'"/>

                <field name="homework_state"
                    widget="badge"
                    decoration-muted="homework_state == 'not_submitted'"
                    decoration-info="homework_state == 'submitted'"
                    decoration-warning="homework_state == 'resubmitted'"
                    decoration-success="homework_state == 'graded'"
                    decoration-danger="homework_state == 'failed'"/>

                <field name="mark"/>

            </list>
        </field>
    </record>



    <!-- Attendance-only list view (no homework/mark columns) -->
    <record id="view_edu_student_attendance_report_list" model="ir.ui.view">
        <field name="name">edu.student.attendance.report.list</field>
        <field name="model">edu.student.lesson.report</field>
        <field name="arch" type="xml">
            <list string="Davomatlar"
                create="0" edit="0" delete="0"
                js_class="attendance_report_dashboard_list">

                <field name="start_datetime" string="Boshlash vaqti"/>
                <field name="timetable_name" string="Dars nomi"/>
                <field name="group_id" string="Guruh"/>
                <field name="slide_id" string="Dars slayd"/>

                <field name="timetable_state"
                    string="Dars holati"
                    widget="badge"
                    decoration-info="timetable_state == 'scheduled'"
                    decoration-warning="timetable_state == 'in_progress'"
                    decoration-success="timetable_state == 'completed'"
                    decoration-danger="timetable_state == 'cancelled'"/>

                <field name="attendance_status"
                    string="Davomat"
                    widget="badge"
                    decoration-success="attendance_status == 'present'"
                    decoration-danger="attendance_status == 'absent'"/>

            </list>
        </field>
    </record>

    <!-- Add Davomatlar smart button -->
    <record id="view_student_partner_form_add_davomatlar_button" model="ir.ui.view">
        <field name="name">res.partner.form.student.add.davomatlar.button</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="ustudy_student.view_student_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_student_attendance_report"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-check-square-o">
                    <field name="attendance_ratio" widget="statinfo" string="Davomatlar"/>
                </button>
            </xpath>
        </field>
    </record>

    <!-- Add Vazifalar smart button -->
    <record id="view_student_partner_form_add_vazifalar_button" model="ir.ui.view">
        <field name="name">res.partner.form.student.add.vazifalar.button</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="ustudy_student.view_student_partner_form"/>
        <field name="arch" type="xml">

            <!-- after Topshiriqlar button -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_student_lessons_report"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-calendar-check-o">
                    <field name="ops_ratio" widget="statinfo" string="Vazifalar"/>
                </button>
            </xpath>

        </field>
    </record>

</odoo>
