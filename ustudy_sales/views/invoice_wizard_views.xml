<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_edu_sale_invoice_wizard_form" model="ir.ui.view">
        <field name="name">edu.sale.invoice.wizard.form</field>
        <field name="model">edu.sale.invoice.wizard</field>
        <field name="arch" type="xml">
            <form string="Hisob-faktura yaratish">
                <group>
                    <group>
                        <field name="order_id"/>
                        <field name="partner_id"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="amount_due" widget="monetary"
                               options="{'currency_field': 'currency_id'}"/>
                    </group>
                    <group>
                        <field name="amount" widget="monetary"
                               options="{'currency_field': 'currency_id'}"/>
                        <field name="payment_method_id"
                               options="{'no_create': True}"/>
                        <field name="date"/>
                    </group>
                </group>
                <group>
                    <field name="description" nolabel="1"
                           placeholder="Izoh..."/>
                </group>
                <div class="alert alert-info" role="alert">
                    Yozuv <b>qoralama</b> holatida yaratiladi va kassa
                    To'lovlar ilovasida tasdiqlagach «To'langan» hisoblanadi.
                </div>
                <footer>
                    <button name="action_create_invoice" type="object"
                            string="Yaratish" class="btn-primary"/>
                    <button string="Bekor qilish" special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
