<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============ Category + Privilege (Odoo 19) ============ -->
        <record id="module_category_sifat_nazorat" model="ir.module.category">
            <field name="name">Sifat Nazorat</field>
            <field name="description">Sifat Nazorat ilovasidagi rollar</field>
            <field name="sequence">52</field>
        </record>

        <record id="privilege_sifat_nazorat" model="res.groups.privilege">
            <field name="name">Sifat Nazorat roli</field>
            <field name="category_id" ref="module_category_sifat_nazorat"/>
            <field name="sequence">52</field>
        </record>

        <!-- ============ Roles ============ -->

        <!-- Foydalanuvchi: works with the records (classify sababli/sababsiz),
             but does NOT see the root app menu -->
        <record id="group_sn_user" model="res.groups">
            <field name="name">Foydalanuvchi</field>
            <field name="privilege_id" ref="privilege_sifat_nazorat"/>
            <field name="comment">Yozuvlarni ko'radi va sabab tasnifini belgilaydi;
                Sifat Nazorat ilovasi (root menyu) ko'rinmaydi.</field>
        </record>

        <!-- Administrator: sees the root app, full rights incl. delete -->
        <record id="group_sn_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="privilege_id" ref="privilege_sifat_nazorat"/>
            <field name="implied_ids" eval="[(4, ref('group_sn_user'))]"/>
            <field name="comment">Sifat Nazorat ilovasini to'liq boshqaradi
                (root menyu faqat shu rolga ko'rinadi).</field>
        </record>

        <!-- System admins are Sifat Nazorat admins automatically -->
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_sn_admin'))]"/>
        </record>

    </data>
</odoo>
