<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_absence_reason_wizard_form" model="ir.ui.view">
        <field name="name">edu.absence.reason.wizard.form</field>
        <field name="model">edu.absence.reason.wizard</field>
        <field name="arch" type="xml">
            <form string="Sabab tasnifi">
                <group>
                    <field name="line_id" invisible="1"/>
                    <field name="student_name"/>
                    <field name="reason" widget="radio" options="{'horizontal': true}"/>
                    <field name="description"
                           placeholder="Kelmaganlik sababi haqida izoh (ixtiyoriy)..."/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Saqlash"
                            class="btn-primary"/>
                    <button string="Bekor qilish" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
