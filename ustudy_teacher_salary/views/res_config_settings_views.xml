<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_finance_salary_config_settings" model="ir.ui.view">
        <field name="name">to'lovlar.sozlamalari.form</field>
        <field name="model">res.config.settings</field>
        <field name="arch" type="xml">
            <form string="To'lovlar sozlamalari" class="oe_form_configuration">
                <sheet>
                    <group string="Ustoz oyligi">
                        <field name="teacher_salary_active_basis"/>
                        <field name="teacher_salary_default_method_id"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Saqlash" type="object" name="execute"
                            class="btn-primary"/>
                    <button string="Bekor qilish" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_finance_salary_config_settings" model="ir.actions.act_window">
        <field name="name">To'lovlar sozlamalari</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_finance_salary_config_settings"/>
    </record>

</odoo>
